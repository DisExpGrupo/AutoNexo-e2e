E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8080/api

# Location of the test workshop — the setup script registers the workshop
# at these coords, and the car owner creates a service request at the same
# coords so matching finds the workshop.
E2E_WORKSHOP_LATITUDE=-12.108527
E2E_WORKSHOP_LONGITUDE=-76.992718

E2E_HEADLESS=true
E2E_SLOWMO=0
E2E_VIDEO=false
E2E_VIDEO_DIR=artifacts/videos
# Set to "true" to print debug logs (HTTP responses, page errors, navigations)
E2E_DEBUG=false

# DB connection for before-suite table truncation (CI + local dev with Docker Compose)
E2E_DB_HOST=localhost
E2E_DB_PORT=3306
E2E_DB_NAME=autonexo-database
E2E_DB_USER=root
E2E_DB_PASSWORD=Admin-123
